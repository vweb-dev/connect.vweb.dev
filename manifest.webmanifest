{
  "name": "VWEB.DEV Connect",
  "short_name": "Connect",
  "description": "Free browser-first tools, learning paths, software directory and QR studio.",
  "start_url": "/#home",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0d1117",
  "theme_color": "#0d1117",
  "icons": [
    {
      "src": "https://vweb.dev/Favicon/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "https://vweb.dev/Favicon/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/connect-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/connect-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "id": "/",
  "categories": [
    "productivity",
    "education",
    "utilities"
  ],
  "shortcuts": [
    {
      "name": "QR Code Studio",
      "short_name": "QR Studio",
      "url": "/#qr",
      "description": "Build customized QR codes with logo and export"
    },
    {
      "name": "File Converter",
      "short_name": "Convert",
      "url": "/#convert",
      "description": "Local image, PDF and media tasks"
    },
    {
      "name": "App Directory",
      "short_name": "Apps",
      "url": "/#apps",
      "description": "Verified software and app directory"
    },
    {
      "name": "Connect Learning",
      "short_name": "Learn",
      "url": "/#academy",
      "description": "Your courses, modules, notes and progress"
    },
    {
      "name": "Quick Actions",
      "short_name": "Actions",
      "url": "/#tools",
      "description": "Password, text and developer utilities"
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ]
}
