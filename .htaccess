Options -Indexes
DirectoryIndex seo.php index.html
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On
# Retired media catalog: block the old URL even if hosting retains the file.
RewriteRule ^data/entertainment\.json$ - [G,L,NC]
RewriteRule ^(?:\.git|vendor|node_modules)(?:/|$) - [F,L,NC]
# Human-readable public URLs, dynamically rendered page metadata
# Dedicated tool and course pages share server-rendered metadata, not hash fragments.
RewriteRule ^(?:tools|convert|ai|qr|daily|windows|network)/[a-z0-9-]+/?$ seo.php [L,QSA,NC]
RewriteRule ^academy/course/[a-z0-9-]+/?$ seo.php [L,QSA,NC]
RewriteRule ^(?:tools|qr|convert|ai|academy|apps|pc|network|daily|studios|play|community|offers|dashboard|account)/?$ seo.php [L,QSA,NC]
</IfModule>


# Low-overhead delivery: cache versioned static assets, revalidate the HTML
# application shell/service worker, never make user/API data publicly cacheable.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|svg|png|jpe?g|webp|avif|woff2?)$">
    Header set Cache-Control "public, max-age=3600, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=3600"
  </FilesMatch>
  <FilesMatch "^(?:index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
